APP_NAME=Rail Intel MVP
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://railintel:railintel@postgres:5432/railintel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

RAILWAY_PROVIDER=mock
REAL_PROVIDER_BASE_URL=
REAL_PROVIDER_API_KEY=
REAL_PROVIDER_TIMEOUT_SECONDS=5
REAL_PROVIDER_MAX_RETRIES=3
REAL_PROVIDER_MAX_CONNECTIONS=100
REAL_PROVIDER_MAX_KEEPALIVE_CONNECTIONS=20
REAL_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
REAL_PROVIDER_MAX_RETRY_BACKOFF_SECONDS=2
REAL_PROVIDER_SEARCH_PATH=/trains/search
REAL_PROVIDER_ROUTE_PATH_TEMPLATE=/trains/{train_number}/route
REAL_PROVIDER_AVAILABILITY_PATH=/availability
ENABLE_PROVIDER_CACHE=true
CACHE_BACKEND=memory
ROUTE_CACHE_TTL_SECONDS=86400
AVAILABILITY_CACHE_TTL_SECONDS=60
STATION_CACHE_TTL_SECONDS=604800
MONITOR_REPOSITORY=memory

AI_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ROUTE_MAX_STATION_EXTENSION=2
ROUTE_MIN_OVERLAP_RATIO=0.35
ROUTE_MAX_CANDIDATES_PER_TRAIN=12
ROUTE_AVAILABILITY_TIMEOUT_SECONDS=8
ROUTE_AVAILABILITY_CONCURRENCY=12
